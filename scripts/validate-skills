#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
failures=0
count=0

fail() {
  echo "ERROR: $1" >&2
  failures=$((failures + 1))
}

for skill_dir in "$repo_root"/skills/*; do
  [ -d "$skill_dir" ] || continue
  count=$((count + 1))
  skill_name=$(basename "$skill_dir")
  skill_file="$skill_dir/SKILL.md"

  case "$skill_name" in
    ''|*[!a-z0-9-]*|-*|*--*|*-)
      fail "$skill_name: invalid directory name"
      ;;
  esac
  [ "${#skill_name}" -lt 64 ] || fail "$skill_name: name must be shorter than 64 characters"

  if [ ! -f "$skill_file" ]; then
    fail "$skill_name: missing SKILL.md"
    continue
  fi

  first_line=$(sed -n '1p' "$skill_file")
  [ "$first_line" = "---" ] || fail "$skill_name: SKILL.md must start with YAML frontmatter"

  frontmatter=$(sed -n '2,/^---$/p' "$skill_file")
  echo "$frontmatter" | grep -Eq '^name:[[:space:]]*[^[:space:]].*$' || fail "$skill_name: missing frontmatter name"
  echo "$frontmatter" | grep -Eq '^description:[[:space:]]*[^[:space:]].*$' || fail "$skill_name: missing frontmatter description"
  echo "$frontmatter" | grep -Eq "^name:[[:space:]]*[\"']?$skill_name[\"']?[[:space:]]*$" || fail "$skill_name: frontmatter name must match directory"
  if grep -Eq 'TODO:|__SKILL_NAME__' "$skill_file"; then
    fail "$skill_name: unfinished template placeholder"
  fi

  for host in .claude .agents; do
    link="$repo_root/$host/skills/$skill_name"
    [ -L "$link" ] || fail "$skill_name: missing $host/skills link"
    [ -e "$link/SKILL.md" ] || fail "$skill_name: broken $host/skills link"
  done
done

if [ "$failures" -ne 0 ]; then
  echo "$failures validation error(s)" >&2
  exit 1
fi

echo "Validated $count skill(s)."
